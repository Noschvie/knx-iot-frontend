# KNX IoT Frontend & BFF - Environment Configuration

# ===== Docker Compose Configuration =====
# Timezone Configuration
# Examples: Europe/Vienna, Europe/Berlin, America/New_York, UTC
TZ=Europe/Vienna

# ===== BFF (Backend-for-Frontend) Configuration =====
NODE_ENV=production
LOG_LEVEL=info

# Gateway Configuration (Gateway runs independently in a separate stack)
GATEWAY_URL=http://knx-gateway.local:8080
GATEWAY_WS_URL=ws://knx-gateway.local:8080
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Syslog Configuration (for UDP forwarding)
# Syslog server hostname or IP address
SYSLOG_HOST=syslog-server.local
# Syslog server UDP port (default: 514)
SYSLOG_PORT=514

# ===== Frontend Configuration =====
# The frontend is served by nginx and talks same-origin to the BFF, which proxies
# the KNX gateway. No API_BASE/WS_BASE needed — nginx forwards /api, /info and
# /messaging/ws to the BFF container.
